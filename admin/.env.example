# Public Convex deployment URL used by the browser client.
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Default outbound-call number pre-filled on the business search screen and
# used for every "Select" unless the admin overrides it. Must match (or be
# reachable independently of) the Convex deployment's DEFAULT_CALL_PHONE.
VITE_DEFAULT_CALL_PHONE=+971588711809
