# Copy this file to .env.local and fill in the real value.
# Never commit the actual deployment URL/secrets for other environments here.
VITE_CONVEX_URL=https://<your-deployment-name>.convex.cloud

# Optional: pre-fills the search screen's "call phone override" input the
# first time it loads in a browser (it's then persisted in localStorage).
# Should match the backend's DEFAULT_CALL_PHONE Convex env var if set.
VITE_DEFAULT_CALL_PHONE=+971588711809
